# ======================================================
# SASTGuard - Environment Variables Example
# Copy to .env and adjust values. NEVER commit real secrets.
# ======================================================

# --- Application ---
APP_NAME=SASTGuard
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=sastguard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sastguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL used by SQLAlchemy. For local (non-docker) dev you can use sqlite:
# DATABASE_URL=sqlite:///./sastguard.db
DATABASE_URL=postgresql+psycopg2://sastguard:change_me_in_production@postgres:5432/sastguard

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Ollama (local AI) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60

# --- Uploads ---
UPLOAD_MAX_BYTES=20971520        # 20 MB
UPLOAD_DIR=/data/uploads
ALLOWED_EXTENSIONS=.py,.js,.jsx,.mjs,.cjs,.ts,.tsx,.java,.zip

# --- Security Gate (default policy) ---
GATE_FAIL_CRITICAL=1
GATE_FAIL_HIGH=3
GATE_WARN_MEDIUM=5

# --- Authentication ---
# Must be true in production. AUTH_ENABLED=false is only for the CLI/CI context
# or a local demo; the app REFUSES to start with it false when APP_ENV=production.
AUTH_ENABLED=true
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
# The app refuses to start in production if this is the default or too short.
SECRET_KEY=change_me_use_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Initial admin, created ONLY on first startup when no user exists AND
# ADMIN_PASSWORD is set. There are NO default credentials and the password is
# never logged. If ADMIN_PASSWORD is empty, no admin is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Comma-separated allowed origins for the dashboard (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
# Token sent as Authorization: Bearer. The dashboard stores it in localStorage.
